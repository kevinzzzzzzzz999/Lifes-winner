[
  {
    "id": "libai-xinglunan-1",
    "text": "长风破浪会有时，直挂云帆济沧海。",
    "author": "李白",
    "title": "行路难三首·其一",
    "note": "越过眼前的难处，仍可以怀着信心向前。",
    "sourceURL": "https://zh.wikisource.org/zh-hant/%E8%A1%8C%E8%B7%AF%E9%9A%BE%E4%B8%89%E9%A6%96"
  },
  {
    "id": "liuyuxi-chouletian-yangzhou",
    "text": "沉舟侧畔千帆过，病树前头万木春。",
    "author": "刘禹锡",
    "title": "酬乐天扬州初逢席上见赠",
    "note": "新生总在发生，今天的努力值得珍惜。",
    "sourceURL": "https://zh.wikisource.org/wiki/%E9%85%AC%E6%A8%82%E5%A4%A9%E6%8F%9A%E5%B7%9E%E5%88%9D%E9%80%A2%E5%B8%AD%E4%B8%8A%E8%A6%8B%E8%B4%88"
  },
  {
    "id": "liuyuxi-langtaosha-8",
    "text": "千淘万漉虽辛苦，吹尽狂沙始到金。",
    "author": "刘禹锡",
    "title": "浪淘沙九首·其八",
    "note": "认真打磨，让点滴积累渐渐显出光亮。",
    "sourceURL": "https://zh.wikisource.org/zh-hant/%E6%B5%AA%E6%B7%98%E6%B2%99%E4%B9%9D%E9%A6%96"
  },
  {
    "id": "wanganshi-dengfeilaifeng",
    "text": "不畏浮云遮望眼，只缘身在最高层。",
    "author": "王安石",
    "title": "登飞来峰",
    "note": "站得更高，也就能把眼前的阻碍看得更清。",
    "sourceURL": "https://zh.wikisource.org/wiki/%E7%99%BB%E9%A3%9B%E4%BE%86%E5%B3%B0"
  },
  {
    "id": "sushi-hedongchuan-liubie",
    "text": "粗缯大布裹生涯，腹有诗书气自华。",
    "author": "苏轼",
    "title": "和董传留别",
    "note": "读过的书，会慢慢沉淀成你的气度。",
    "sourceURL": "https://zh.wikisource.org/wiki/%E5%92%8C%E8%91%A3%E5%82%B3%E7%95%99%E5%88%A5"
  },
  {
    "id": "sushi-tixilinbi",
    "text": "横看成岭侧成峰，远近高低各不同。",
    "author": "苏轼",
    "title": "题西林壁",
    "note": "多换一个角度，理解就多一分完整。",
    "sourceURL": "https://zh.wikisource.org/wiki/%E9%A1%8C%E8%A5%BF%E6%9E%97%E5%A3%81"
  },
  {
    "id": "hanyu-zaochun-shuibu-1",
    "text": "天街小雨润如酥，草色遥看近却无。",
    "author": "韩愈",
    "title": "早春呈水部张十八员外二首·其一",
    "note": "细小的变化，也在悄悄酝酿新的生机。",
    "sourceURL": "https://zh.wikisource.org/wiki/%E6%97%A9%E6%98%A5%E5%91%88%E6%B0%B4%E9%83%A8%E5%BC%B5%E5%8D%81%E5%85%AB%E5%93%A1%E5%A4%96"
  },
  {
    "id": "sushi-yinhushang-2",
    "text": "水光潋滟晴方好，山色空蒙雨亦奇。",
    "author": "苏轼",
    "title": "饮湖上初晴后雨二首·其二",
    "note": "晴雨各有风景，也欣赏此刻的自己。",
    "sourceURL": "https://zh.wikisource.org/wiki/%E9%A3%B2%E6%B9%96%E4%B8%8A%E5%88%9D%E6%99%B4%E5%BE%8C%E9%9B%A8%E4%BA%8C%E9%A6%96"
  },
  {
    "id": "luyou-dongye-dushu",
    "text": "纸上得来终觉浅，绝知此事要躬行。",
    "author": "陆游",
    "title": "冬夜读书示子聿",
    "note": "把所学付诸行动，理解便更深一层。",
    "sourceURL": "https://zh.wikisource.org/zh-hans/%E5%86%AC%E5%A4%9C%E8%AE%80%E6%9B%B8%E7%A4%BA%E5%AD%90%E8%81%BF"
  },
  {
    "id": "luyou-youshanxicun",
    "text": "山重水复疑无路，柳暗花明又一村。",
    "author": "陆游",
    "title": "游山西村",
    "note": "再走一步，新的转机也许就在前方。",
    "sourceURL": "https://zh.wikisource.org/zh-hans/%E9%81%8A%E5%B1%B1%E8%A5%BF%E6%9D%91"
  },
  {
    "id": "zhuxi-guanshuyougan-1",
    "text": "问渠那得清如许，为有源头活水来。",
    "author": "朱熹",
    "title": "观书有感·其一",
    "note": "让学习持续流动，心中便常有清明。",
    "sourceURL": "https://zh.wikisource.org/zh-hans/%E8%A7%80%E6%9B%B8%E6%9C%89%E6%84%9F"
  },
  {
    "id": "yangwanli-xiaochu-jingcisi",
    "text": "接天莲叶无穷碧，映日荷花别样红。",
    "author": "杨万里",
    "title": "晓出净慈寺送林子方",
    "note": "为今日的收获，留一刻明亮的欢喜。",
    "sourceURL": "https://www.edb.gov.hk/attachment/tc/curriculum-development/kla/chi-edu/recommended-passages/ks2_16_text.pdf"
  }
]
